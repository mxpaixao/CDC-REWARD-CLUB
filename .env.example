# Banco principal (docker compose sobe em localhost:5432)
DATABASE_URL="postgresql://clube:clube@localhost:5432/clube"
# Banco usado pelos testes de integração (é apagado e recriado a cada execução)
TEST_DATABASE_URL="postgresql://clube:clube@localhost:5432/clube_test"

# Sessão dos usuários internos
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Senha inicial dos usuários sintéticos do seed (só ambiente local)
SEED_PASSWORD="troque-esta-senha"

# URL pública usada em links e QR (/i/{CODIGO})
PUBLIC_BASE_URL="http://localhost:3000"

# debug | info | warn | error | silent
LOG_LEVEL=info

# Notas fiscais (etapa 3)
# Pasta monitorada onde o SHX/GIX deixa os XMLs
XML_INBOX_DIR="var/inbox"
# Armazenamento restrito dos XMLs brutos (permissão só do usuário do serviço)
RAW_XML_DIR="var/xml"
# Notas de homologação (tpAmb 2) só são aceitas em ambiente local. Em produção: false.
ACCEPT_HOMOLOGATION_XML=true
