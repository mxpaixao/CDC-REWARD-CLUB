// Motor Clube CDC — schema do banco.
// Etapa 1 (Base): lojas, usuários internos, sessões, auditoria e parâmetros com vigência.
// As demais entidades da SPEC seção 5 entram nas etapas seguintes, cada uma com sua migração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternalRole {
  ADMIN
  CHANNEL_MANAGER
  CASHIER
}

/// Loja (SPEC 5). `code` é o identificador estável usado em parâmetros (ex.: enabled_store_ids = ["L1"]).
model Store {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  /// CNPJ normalizado (14 posições, maiúsculas, sem pontuação).
  cnpj      String   @unique
  isPilot   Boolean  @default(false) @map("is_pilot")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    InternalUser[]
  invoices Invoice[]

  @@map("store")
}

/// Usuário interno (SPEC 3 e 5).
model InternalUser {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  /// E-mail sempre em minúsculas.
  email                 String       @unique
  role                  InternalRole
  storeId               String?      @map("store_id") @db.Uuid
  store                 Store?       @relation(fields: [storeId], references: [id])
  /// Gerente de canal responsável (para vendedores e operadores).
  channelManagerId      String?      @map("channel_manager_id") @db.Uuid
  channelManager        InternalUser? @relation("ChannelManager", fields: [channelManagerId], references: [id])
  managedUsers          InternalUser[] @relation("ChannelManager")
  passwordHash          String       @map("password_hash")
  active                Boolean      @default(true)
  failedLoginAttempts   Int          @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?    @map("locked_until") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  parameterVersions ParameterVersion[]
  auditEntries      AuditLog[]
  importBatches     ImportBatch[]

  @@map("internal_user")
}

/// Sessão de usuário interno. Guardamos só o hash do token.
model Session {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @map("token_hash")
  userId    String       @map("user_id") @db.Uuid
  user      InternalUser @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

/// Auditoria (regra inviolável 8): quem, o quê, antes, depois e quando. Só inserção — trigger bloqueia UPDATE e DELETE.
model AuditLog {
  id        BigInt        @id @default(autoincrement())
  /// Usuário interno que fez a ação; nulo quando a ação é de um job ou do sistema.
  userId    String?       @map("user_id") @db.Uuid
  user      InternalUser? @relation(fields: [userId], references: [id])
  /// "user", "job:<nome>" ou "system".
  actor     String
  action    String
  entity    String
  entityId  String        @map("entity_id")
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_log")
}

/// Versão de parâmetro (SPEC 4). Imutável: mudança cria nova versão com início de vigência.
model ParameterVersion {
  id          String        @id @default(uuid()) @db.Uuid
  key         String
  value       Json
  validFrom   DateTime      @map("valid_from") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid
  createdBy   InternalUser? @relation(fields: [createdById], references: [id])
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, validFrom])
  @@index([key, validFrom(sort: Desc)])
  @@map("parameter_version")
}

// ---------------------------------------------------------------------------
// Etapa 2 — Cadastros auxiliares
// ---------------------------------------------------------------------------

enum ImportType {
  XML
  PRODUCTS
  EXCLUSIONS
  STORES
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Lote de importação (SPEC 5): tipo, arquivo, início, fim, totais e erros.
model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  type        ImportType
  fileName    String       @map("file_name")
  /// SHA-256 do conteúdo, para rastrear reimportações do mesmo arquivo.
  fileSha256  String       @map("file_sha256")
  /// "incremental" ou "completo" (lista de exclusão).
  mode        String       @default("incremental")
  status      ImportStatus @default(RUNNING)
  startedAt   DateTime     @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(3)
  /// { lidas, novas, atualizadas, semMudanca, removidas, erros, ... }
  totals      Json         @default("{}")
  /// [{ linha, mensagem }] — sem CPF ou CNPJ em claro.
  errors      Json         @default("[]")
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   InternalUser? @relation(fields: [createdById], references: [id])

  products      Product[]
  exclusions    ExclusionEntry[]
  invoices      Invoice[]
  cancellations InvoiceCancellation[]

  @@index([type, startedAt(sort: Desc)])
  @@map("import_batch")
}

enum MarginBand {
  A
  B
  C
  D
}

/// Produto (SPEC 5). A faixa guardada aqui é a calculada na última importação do cadastro,
/// para consulta; a faixa que vale para o crédito é congelada no item da nota (R5.2).
model Product {
  id                String       @id @default(uuid()) @db.Uuid
  /// cProd do XML.
  code              String       @unique
  description       String
  category          String?
  /// Margem bruta em %, decimal exato.
  marginPct         Decimal      @map("margin_pct") @db.Decimal(9, 4)
  band              MarginBand
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @map("updated_at") @db.Timestamptz(3)
  lastImportBatchId String?      @map("last_import_batch_id") @db.Uuid
  lastImportBatch   ImportBatch? @relation(fields: [lastImportBatchId], references: [id])

  @@map("product")
}

enum ExclusionReason {
  B2B_NEGOTIATED
  EMPLOYEE
  OTHER
}

/// Lista de exclusão (SPEC 5, R1.2, R3.2, R5.4, R5.8). Cada linha é um período em que o documento
/// esteve na lista: [addedAt, removedAt). Só um período aberto por documento (índice parcial na migração).
model ExclusionEntry {
  id                String          @id @default(uuid()) @db.Uuid
  document          String
  documentType      String          @map("document_type")
  reason            ExclusionReason
  /// Origem da informação (ex.: "RH", "SHX-B2B", "manual").
  source            String
  addedAt           DateTime        @map("added_at") @db.Timestamptz(3)
  removedAt         DateTime?       @map("removed_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)
  lastImportBatchId String?         @map("last_import_batch_id") @db.Uuid
  lastImportBatch   ImportBatch?    @relation(fields: [lastImportBatchId], references: [id])

  @@index([document])
  @@index([source])
  @@map("exclusion_entry")
}

// ---------------------------------------------------------------------------
// Etapa 3 — Notas fiscais
// ---------------------------------------------------------------------------

enum InvoiceDirection {
  OUT
  IN
}

enum InvoiceStatus {
  AUTHORIZED
  CANCELED
}

/// Nota fiscal importada (SPEC 5 e 7). Única pela chave de acesso (regra 3).
/// Imutável depois de gravada, exceto situação e data de cancelamento (trigger na migração).
model Invoice {
  id                    String           @id @default(uuid()) @db.Uuid
  /// Chave de acesso, 44 posições.
  accessKey             String           @unique @map("access_key")
  /// 55 (NF-e) ou 65 (NFC-e).
  model                 Int
  series                String
  number                String
  /// tpNF: OUT = saída (1), IN = entrada (0).
  direction             InvoiceDirection
  /// finNFe: 1 normal, 2 complementar, 3 ajuste, 4 devolução.
  purpose               Int
  /// PRODUCTION ou HOMOLOGATION (tpAmb).
  environment           String
  issuedAt              DateTime         @map("issued_at") @db.Timestamptz(3)
  storeId               String           @map("store_id") @db.Uuid
  store                 Store            @relation(fields: [storeId], references: [id])
  /// CPF ou CNPJ normalizado; nulo quando o cliente não se identificou.
  recipientDocument     String?          @map("recipient_document")
  recipientDocumentType String?          @map("recipient_document_type")
  totalCents            Int              @map("total_cents")
  discountCents         Int              @map("discount_cents")
  /// Códigos tPag.
  paymentTypes          String[]         @map("payment_types")
  /// infCpl
  additionalInfo        String?          @map("additional_info")
  /// refNFe — numa devolução, a chave da venda devolvida.
  referencedKeys        String[]         @map("referenced_keys")
  itemCount             Int              @map("item_count")
  /// Itens só são guardados quando a nota identifica o cliente (ou é devolução).
  itemsStored           Boolean          @map("items_stored")
  status                InvoiceStatus    @default(AUTHORIZED)
  canceledAt            DateTime?        @map("canceled_at") @db.Timestamptz(3)
  authorizationStatus   Int              @map("authorization_status")
  authorizationProtocol String?          @map("authorization_protocol")
  importBatchId         String           @map("import_batch_id") @db.Uuid
  importBatch           ImportBatch      @relation(fields: [importBatchId], references: [id])
  /// Caminho do XML bruto no armazenamento restrito (R13.4); nulo para nota sem cliente identificado.
  rawXmlPath            String?          @map("raw_xml_path")
  rawSha256             String?          @map("raw_sha256")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  items InvoiceItem[]

  @@index([recipientDocument, issuedAt])
  @@index([storeId, issuedAt])
  @@index([referencedKeys], type: Gin)
  @@map("invoice")
}

/// Item da nota (SPEC 5). A faixa é congelada na importação (R5.2).
model InvoiceItem {
  id            String     @id @default(uuid()) @db.Uuid
  invoiceId     String     @map("invoice_id") @db.Uuid
  invoice       Invoice    @relation(fields: [invoiceId], references: [id])
  itemNumber    Int        @map("item_number")
  /// cProd
  productCode   String     @map("product_code")
  description   String
  cfop          String
  /// qCom
  quantity      Decimal    @db.Decimal(15, 4)
  /// vProd
  grossCents    Int        @map("gross_cents")
  /// vDesc
  discountCents Int        @map("discount_cents")
  /// vProd − vDesc (R5.1)
  baseCents     Int        @map("base_cents")
  band          MarginBand
  /// false quando o produto não estava cadastrado: faixa D e relatório "itens sem faixa".
  productFound  Boolean    @map("product_found")

  @@unique([invoiceId, itemNumber])
  @@index([productCode])
  @@map("invoice_item")
}

/// Evento de cancelamento (110111 ou 110112). Pode chegar antes da nota: fica pendente até a nota ser importada.
model InvoiceCancellation {
  id            String      @id @default(uuid()) @db.Uuid
  accessKey     String      @unique @map("access_key")
  eventType     String      @map("event_type")
  sequence      Int
  eventAt       DateTime    @map("event_at") @db.Timestamptz(3)
  protocol      String?
  /// Chave da NFC-e substituta (110112).
  substituteKey String?     @map("substitute_key")
  /// Quando o cancelamento foi aplicado à nota; nulo enquanto a nota não chegou.
  appliedAt     DateTime?   @map("applied_at") @db.Timestamptz(3)
  importBatchId String      @map("import_batch_id") @db.Uuid
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
  rawXmlPath    String?     @map("raw_xml_path")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("invoice_cancellation")
}
